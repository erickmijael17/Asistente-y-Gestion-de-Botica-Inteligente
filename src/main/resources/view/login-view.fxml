<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.botica.inteligente.ui.LoginController" styleClass="auth-screen">
    <VBox spacing="14" styleClass="auth-card">
        <Label text="BOTICA INTELIGENTE" styleClass="brand-title" />
        <Label text="Iniciar sesión" styleClass="auth-title" />
        <Label text="Usuario" />
        <TextField fx:id="usernameField" promptText="Nombre de usuario" onAction="#ingresar" />
        <Label text="Contraseña" />
        <PasswordField fx:id="passwordField" promptText="Contraseña" onAction="#ingresar" />
        <Label fx:id="errorLabel" wrapText="true" styleClass="auth-error" />
        <Button fx:id="ingresarButton" text="Ingresar" onAction="#ingresar" maxWidth="Infinity" />
    </VBox>
</VBox>
