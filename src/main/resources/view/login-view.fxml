<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.botica.inteligente.ui.LoginController" styleClass="auth-screen">
    <VBox spacing="14" styleClass="auth-card">
        <HBox alignment="CENTER_RIGHT">
            <Region HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="idiomaCombo" prefWidth="110" />
        </HBox>
        <Label text="%login.marca" styleClass="brand-title" />
        <Label text="%login.titulo" styleClass="auth-title" />
        <Label text="%login.usuario" />
        <TextField fx:id="usernameField" promptText="%login.usuario.prompt" onAction="#ingresar" />
        <Label text="%login.password" />
        <PasswordField fx:id="passwordField" promptText="%login.password.prompt" onAction="#ingresar" />
        <Label fx:id="errorLabel" wrapText="true" styleClass="auth-error" />
        <Button fx:id="ingresarButton" text="%login.ingresar" onAction="#ingresar" maxWidth="Infinity" />
    </VBox>
</VBox>
