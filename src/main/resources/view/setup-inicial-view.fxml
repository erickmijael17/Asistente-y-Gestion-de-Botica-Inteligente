<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.botica.inteligente.ui.SetupInicialController" styleClass="auth-screen">
    <VBox spacing="14" styleClass="auth-card">
        <Label text="Configuración inicial" styleClass="auth-title" />
        <Label text="Crea la cuenta OWNER para administrar la botica." wrapText="true" />
        <Label text="Usuario" />
        <TextField fx:id="usernameField" promptText="Nombre de usuario" />
        <Label text="Contraseña" />
        <PasswordField fx:id="passwordField" promptText="Mínimo 8 caracteres" />
        <Label text="Confirmar contraseña" />
        <PasswordField fx:id="confirmacionField" promptText="Repite la contraseña" />
        <Label fx:id="errorLabel" wrapText="true" styleClass="auth-error" />
        <Button fx:id="crearOwnerButton" text="Crear OWNER" onAction="#crearOwner" maxWidth="Infinity" />
    </VBox>
</VBox>
